+    for (const [dx, dy] of nb) {
+      const nx2 = cx + dx, ny2 = cy + dy;
+      if (nx2 < 1 || ny2 < 1 || nx2 >= GW - 1 || ny2 >= GH - 1) continue;
+      const ni = ny2 * GW + nx2;
