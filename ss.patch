+// --- ساخت نقشه ---
+export function genWorldMap(seed, tl) {
+  const rng = mulberry32(seed ^ 0x71ce);
+  const noise = makeNoise2D(mulberry32(seed ^ 0x55aa));
+  const land = new Float32Array(WW * WH); // امتیاز خشکی
+  const hgt = new Float32Array(WW * WH);  // ارتفاع
+  const mois = new Float32Array(WW * WH);
+  for (let y = 0; y < WH; y++) for (let x = 0; x < WW; x++) {
+    const i = y * WW + x;
+    let s = 0, best = 99;
+    for (const c of CONTINENTS) {
+      const [cx, cy] = lonLat(c[0], c[1]);
+      const dx = (x - cx) / c[2], dy = (y - cy) / c[3];
+      const d = dx * dx + dy * dy;
+      s += c[4] / (1 + Math.max(d, 0.02) ** 1.5) * (c[5] ?? 1);
+      if (d < best) best = d;
+    }
+    // جزیره‌های نویزی
+    const n = fbm(noise, x * 0.06, y * 0.06, 4);
+    const score = s + (n - 0.5) * 0.33;
+    land[i] = score;
+    hgt[i] = clamp(0.38 + s * 0.35 + (fbm(noise, x * 0.11 + 9, y * 0.11 + 3, 4) - 0.5) * 0.8, 0, 1);
+    mois[i] = clamp(fbm(noise, x * 0.08 + 31, y * 0.08 + 17, 4) + (y / WH - 0.35) * 0.35 + 0.14, 0, 1);
+  }
+  const SEA = 0.545;
+  const isSea = i => land[i] < SEA;
+
+  // --- لنگرها به مختصات خشکی نزدیک ---
+  const anchorCells = [];
+  const anchorOwn = [];
+  for (const c in ANCHORS) {
+    for (const a of ANCHORS[c]) {
+      const own = ownerFor(c, tl);
+      if (!own) continue;
+      const [ax, ay] = lonLat(a[0], a[1]);
+      let bx = clamp(Math.round(ax), 1, WW - 2), by = clamp(Math.round(ay), 1, WH - 2);
+      // اگر لنگر در دریا افتاد، به نزدیک‌ترین خشکی ببر
+      if (isSea(by * WW + bx)) {
+        let found = false, rad = 2;
+        while (rad < 14 && !found) {
+          for (let dy = -rad; dy <= rad && !found; dy++) for (let dx = -rad; dx <= rad && !found; dx++) {
+            const nx = bx + dx, ny = by + dy;
+            if (nx < 1 || ny < 1 || nx >= WW - 1 || ny >= WH - 1) continue;
+            if (!isSea(ny * WW + nx)) { bx = nx; by = ny; found = true; }
+          }
+          rad += 2;
+        }
+      }
+      const idx = by * WW + bx;
+      if (isSea(idx)) continue;
+      anchorCells.push(idx);
+      anchorOwn.push(own);
+    }
+  }
+  // هر سلول خشکی به نزدیک‌ترین لنگر
+  const cellOwn = new Array(WW * WH).fill(null);
+  const q = [];
+  const dist = new Float32Array(WW * WH).fill(1e9);
+  // ناهمواری مرزها (گام همواره مثبت تا جست‌وجو امن بماند)
+  for (let k = 0; k < anchorCells.length; k++) {
+    const i = anchorCells[k];
+    cellOwn[i] = anchorOwn[k];
+    dist[i] = 0;
+    q.push([i, 0]);
+  }
+  let head = 0;
+  while (head < q.length) {
+    const [cur, d] = q[head++];
+    const cx = cur % WW, cy = (cur / WW) | 0;
+    for (const [dx, dy] of [[1, 0], [-1, 0], [0, 1], [0, -1]]) {
+      const nx = cx + dx, ny = cy + dy;
+      if (nx < 0 || ny < 0 || nx >= WW || ny >= WH) continue;
+      const ni = ny * WW + nx;
+      if (isSea(ni)) continue;
+      const nd = d + 0.55 + Math.random() * 0 + (rng() * 1.8); // همیشه مثبت — مرز ناهموار اما پایدار
+      if (nd < dist[ni]) { dist[ni] = nd; cellOwn[ni] = cellOwn[cur]; q.push([ni, nd]); }
+    }
+  }
+  const natIds = {};
+  let nid = 0;
+  const natIdx = {};
+  for (let i = 0; i < cellOwn.length; i++) {
+    const o = cellOwn[i];
+    if (o == null || isSea(i)) { if (!isSea(i)) cellOwn[i] = -1; continue; }
+    if (natIdx[o] === undefined) { natIdx[o] = nid++; }
+    cellOwn[i] = natIdx[o];
+  }
