+  if (c === 'gre') return tl === 'ww1' ? 'gre' : 'gre';
+  if (c === 'aus') return 'aus';
+  if (c === 'nld' && tl === 'modern') return ['idn', 'sgr'].includes(code) ? 'idn' : code;
+  if (c === 'ch2') return null;
+  if (c === 'syr') return 'syr';
+  if (c === 'rost') return null;
