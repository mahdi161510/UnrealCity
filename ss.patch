+// ---------- رندر نقشه: زمین نقاشی‌شده، مُدها، ذرات، ارتش‌ها ----------
+import { GW, GH, CELL, W, H } from './mapgen.js';
+import { clamp, lerp, mulberry32, smoothstep } from './utils.js';
+import { BUILDINGS, TERRAIN, POP_CLASSES } from './data.js';
