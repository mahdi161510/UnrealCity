+    if (cells[i] < 0) continue;
+    const p = provList[idMap.get(cells[i])];
+    const x = i % GW, y = (i / GW) | 0;
+    p.cells.push(i); p.cx += x; p.cy += y; p.elev += elev[i]; p.moist += moist[i];
+  }
