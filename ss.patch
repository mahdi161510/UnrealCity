+    text: 'تبریک! حالا همه‌ی بخش‌ها را می‌شناسید: نقشه, اقتصاد, سیاست, دیپلماسی, جنگ, خانواده‌ی سلطنتی. بازی را شروع کنید و از خط زمان ۱۸۳۶ به ۲۰۲۶ بروید — یا از امروز آغاز کنید.' },
+];
+let tutIdx = -1;
+function tutRender() {
+  const st = TUT_STEPS[tutIdx];
+  const ov = document.getElementById('tut-overlay');
+  ov.style.display = 'flex';
+  // پاک‌سازی هایلایت قبلی
+  document.querySelectorAll('.tut-hl').forEach(x => x.classList.remove('tut-hl'));
+  if (st.sel) {
+    const target = document.querySelector(st.sel);
+    if (target) target.classList.add('tut-hl');
+  }
+  if (st.panel) {
+    if (UI.panel !== st.panel) togglePanel(st.panel);
+  }
+  document.getElementById('tut-title').textContent = st.title;
+  document.getElementById('tut-text').textContent = st.text;
+  document.getElementById('tut-step').textContent = `مرحله ${fd(tutIdx + 1)} از ${fd(TUT_STEPS.length)}`;
+}
+export function startTutorial(startIdx = 0) {
+  if (!S) { toast('⚠️', 'توتوریال فقط درون بازی فعال می‌شود؛ از «بازی جدید» یا «توتوریال کامل» در منوی اصلی شروع کنید.'); return; }
+  tutIdx = startIdx;
+  S.paused = true;
+  tutRender();
+  document.getElementById('tut-next').onclick = () => {
+    Audio2.click();
+    if (tutIdx < TUT_STEPS.length - 1) { tutIdx++; tutRender(); }
+    else endTutorial();
+  };
+  document.getElementById('tut-prev').onclick = () => { Audio2.click(); if (tutIdx > 0) { tutIdx--; tutRender(); } };
+  document.getElementById('tut-exit').onclick = () => { Audio2.click(); endTutorial(); };
+}
+function endTutorial() {
+  document.getElementById('tut-overlay').style.display = 'none';
+  document.querySelectorAll('.tut-hl').forEach(x => x.classList.remove('tut-hl'));
+  S.paused = false;
+  toast('🎓', 'توتوریال پایان یافت — موفق باشید!');
+  saveGame(S);
+}
