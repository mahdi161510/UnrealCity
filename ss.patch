+    const own = cellOwner[i];
+    const target = 6 + Math.floor(rng() * 8);
+    const stack = [i];
+    const cells = [];
+    provCells[i] = provList.length;
+    while (stack.length && cells.length < target) {
+      const c = stack.pop();
+      if (provCells[c] >= 0 && provCells[c] !== provList.length) continue;
+      if (cellOwner[c] !== own || isSea(c)) continue;
+      provCells[c] = provList.length;
+      if (!cells.includes(c)) cells.push(c);
+      const cx = c % WW, cy = (c / WW) | 0;
+      const dirs = [[1, 0], [-1, 0], [0, 1], [0, -1]].sort(() => rng() - 0.5);
+      for (const [dx, dy] of dirs) {
+        const nx = cx + dx, ny = cy + dy;
+        if (nx < 0 || ny < 0 || nx >= WW || ny >= WH) continue;
+        const ni = ny * WW + nx;
+        if (provCells[ni] < 0 && cellOwner[ni] === own && !isSea(ni)) { provCells[ni] = provList.length; stack.push(ni); }
+      }
+    }
+    if (!cells.length) continue;
+    // مرکز استان
+    let sx = 0, sy = 0, se = 0, sm = 0;
+    for (const c of cells) { sx += c % WW; sy += (c / WW) | 0; se += hgt[c]; sm += mois[c]; }
+    const cellsArr = cells.slice();
+    const elev = se / cells.length, moist = sm / cells.length;
+    const terrain = elev > 0.72 ? 'mountain' : elev > 0.6 ? 'hills' : moist > 0.62 ? 'forest' : moist < 0.34 ? 'desert' : moist > 0.72 ? 'wetland' : 'plains';
+    provList.push({
+      id: provList.length, owner: own, cells: cellsArr, ncells: cells.length,
+      cx: ((sx / cells.length) + 0.5) * WCELL, cy: ((sy / cells.length) + 0.5) * WCELL,
+      elev, moist, terrain, adj: [], coast: false,
+      name: natsMeta[own].names[provList.filter(p => p.owner === own).length % natsMeta[own].names.length],
+      res: { farm: clamp(1 - elev * 0.9 + moist * 0.5, 0.1, 1), wood: clamp(moist * 1.1 - elev * 0.4, 0, 1), iron: clamp(0.3 + (rng() - 0.5) * 0.7 + elev * 0.45, 0, 1), coal: clamp(0.28 + (rng() - 0.5) * 0.7 + elev * 0.3, 0, 1) },
+    });
+  }
+  // یکتاسازی نام‌ها در هر ملت
+  for (const o of Object.values(natIdx)) {
+    const mine = provList.filter(p => p.owner === o);
+    mine.forEach((p, i) => { p.name = natsMeta[o].names[i % natsMeta[o].names.length] + (i >= natsMeta[o].names.length ? ' شمالی' : ''); });
+  }
