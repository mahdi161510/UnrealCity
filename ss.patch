+  return {
+    seed: seed ^ 0x71ce,
+    grid: { gw: WW, gh: WH, cell: WCELL, cells: provCells, elev: hgt, moist: mois, seaLevel: SEA_V },
+    provs: provList,
+    nNations: natCodes.length,
+    capitals,
+    rivers, coastSea,
+    w: WW * WCELL, h: WH * WCELL,
+    water_id: -1,
+    worldTL: tl,
+    natCodes, natsMeta,
+  };
+}
