+/* نظامی */
+.army { display: flex; align-items: center; gap: 8px; padding: 7px 9px; margin-bottom: 6px; background: rgba(255,240,200,.04); border: 1px solid rgba(80,66,40,.4); border-radius: 10px; font-size: 12px; }
