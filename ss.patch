+      let dm = 1e9;
+      for (const s of seeds2) { const q = provList[s]; const d = Math.hypot(p.cx - q.cx, p.cy - q.cy); if (d < dm) dm = d; }
+      const dd = dm * (0.7 + rng() * 0.6);
+      if (dd > bd) { bd = dd; best = p.id; }
+    }
+    seeds2.push(best);
+  }
