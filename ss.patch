+// ترکیب ملتِ هر لنگر در هر خط زمانی: WW2/WW1 با مرزهای تاریخی
+function ownerFor(code, tl) {
+  const c = code;
+  if (c === 'aus' || c === 'cze' || c === 'hun' || c === 'srb') return tl === 'ww1' ? 'aus' : c;
+  if (c === 'ott') return tl === 'ww1' ? 'ott' : (tl === 'ww2' ? 'tur' : 'tur');
+  if (c === 'tur' && tl === 'ww1') return 'ott';
+  if (c === 'ind' || c === 'pak' || c === 'mya') return tl === 'modern' ? (c === 'mya' ? 'ind' : c) : (c === 'mya' ? 'ind' : 'gbr');
+  if (c === 'ngo') return null;
+  if (c === 'nga' || c === 'mli' || c === 'mrt' || c === 'ner' || c === 'tcd' || c === 'gab' || c === 'gha' || c === 'civ' || c === 'sen' || c === 'gnb' || c === 'mar' || c === 'dza' || c === 'tun') {
+    return tl === 'modern' ? c : 'fra'; // غرب و شمال آفریقا فرانسوی
+  }
+  if (c === 'drc' || c === 'bel2') return tl === 'modern' ? 'drc' : 'bel';
+  if (c === 'ken' || c === 'uga') return tl === 'modern' ? c : 'gbr';
+  if (c === 'tza') return tl === 'modern' ? 'tza' : (tl === 'ww1' ? 'deu' : 'gbr');
+  if (c === 'nam') return tl === 'modern' ? 'nam' : (tl === 'ww1' ? 'deu' : 'zaf');
+  if (c === 'ago' || c === 'moz') return tl === 'modern' ? c : 'por';
+  if (c === 'zmb') return tl === 'modern' ? 'zmb' : (tl === 'ww1' ? 'gbr' : 'gbr');
+  if (c === 'zwe') return tl === 'modern' ? 'zwe' : 'gbr';
+  if (c === 'bwa') return tl === 'modern' ? 'bwa' : 'zaf';
+  if (c === 'nga2') return tl === 'modern' ? 'nga2' : 'gbr';
+  if (c === 'cmr') return ['ww1', 'ww2'].includes(tl) ? 'deu' : 'cmr';
+  if (c === 'som') return tl === 'modern' ? 'som' : (tl === 'ww1' ? 'ita' : 'ita');
+  if (c === 'sdn' || c === 'egy') return tl === 'modern' ? c : (c === 'egy' && tl === 'ww1' ? 'gbr' : 'gbr');
+  if (c === 'lby') return tl === 'modern' ? 'lby' : 'ita';
+  if (c === 'idn' || c === 'sgr' || c === 'phl' || c === 'aus2') return tl === 'modern' ? c : (tl === 'modern' ? 'aus2' : 'gbr');
+  if (c === 'phl') return tl === 'modern' ? 'phl' : 'usa';
+  if (c === 'idn') return tl === 'modern' ? 'idn' : 'nld';
+  if (c === 'sgr') return tl === 'modern' ? 'sgr' : (tl === 'ww1' ? 'deu' : 'aus2');
+  if (c === 'kor' && tl !== 'modern') return 'jpn';
+  if (c === 'prk' && tl !== 'modern') return 'jpn';
+  if (c === 'eth') return tl === 'ww2' ? 'ita' : 'eth';
+  if (c === 'ukr' || c === 'kaz' || c === 'uzb' || c === 'fin') return tl === 'modern' ? c : 'rus';
+  if (c === 'pol' && tl === 'ww1') return 'deu';
+  if (c === 'pol' && tl === 'ww2') return 'pol';
+  if (c === 'jpn' && tl === 'modern') return 'jpn';
+  if (c === 'tha') return 'tha';
+  if (c === 'afg') return 'afg';
+  if (c === 'irl') return tl === 'modern' ? 'irl' : 'gbr';
+  if (c === 'mog') return tl === 'modern' ? 'mog' : (tl === 'ww1' ? 'rus' : 'mog');
+  if (c === 'vie') return tl === 'modern' ? 'vie' : 'fra';
+  if (c === 'chn' && tl === 'ww2') return 'chn';
+  if (c === 'chn' && tl === 'ww1') return 'chn';
+  if (c === 'pak' && tl === 'ww1') return 'gbr';
+  if (c === 'pak' && tl === 'ww2') return 'gbr';
+  if (c === 'ind' && tl === 'ww1') return 'gbr';
+  if (c === 'ind' && tl === 'ww2') return 'gbr';
+  if (c === 'npl') return 'gbr';
+  if (c === 'lka') return tl === 'modern' ? 'lka' : 'gbr';
+  if (c === 'iro' && tl !== 'modern') return 'gbr';
+  if (c === 'isr') return null; // قبل از ۱۹۴۸ بخش دیگری است
+  if (c === 'syr' || c === 'jor') return tl === 'ww1' ? 'ott' : (tl === 'modern' ? c : 'fra');
+  if (c === 'sau') return tl === 'ww2' || tl === 'modern' ? 'sau' : (tl === 'ww1' ? 'sau' : 'sau');
