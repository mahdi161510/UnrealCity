+  for (let n = 0; n < NN; n++) {
+    const mine = provList.filter(p => p.owner === n);
+    // مؤلفه‌ی برتر خشکی سبزِ این ملت (بخش اصلی قاره — ثروت اصلی این‌جاست؛ جزیره‌ها جدا)
