+    const nx = x / GW, ny = y / GH;
+    let e = fbm(noiseE, nx * 5.2, ny * 5.2, 5) * 0.78 + fbm(noiseD, nx * 13, ny * 13, 3) * 0.34;
+    const dx = (x - cx0) / (GW * 0.52), dy = (y - cy0) / (GH * 0.5);
